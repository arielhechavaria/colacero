NODE_ENV=development
DATABASE_URL=postgresql://colacero:colacero_dev@localhost:5432/colacero_dev
REDIS_URL=redis://localhost:6379
API_PORT=3000
API_HOST=0.0.0.0
# Generar con: openssl rand -hex 32
JWT_SECRET=GENERAR_CON_OPENSSL_RAND_HEX_32
JWT_EXPIRES_IN=7d
# Cookies + refresh tokens
# Generar COOKIE_SECRET con: openssl rand -hex 32
COOKIE_SECRET=GENERAR_CON_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=600
WHATSAPP_PROVIDER=mock
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ── Email / Password reset ────────────────────────────────────────────────
# RESEND_API_KEY=   # Opcional — sin esto, los links aparecen en los logs del server
# FROM_EMAIL=noreply@colacero.com
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24
PANEL_URL=http://localhost:3002   # En prod: https://panel.colacero.com

# ── Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_PROVIDER=mock           # mock | bot-api
# TELEGRAM_BOT_TOKEN=             # Bot de notificaciones del negocio (ej. @elfogon_colaCero_Bot)
# TELEGRAM_AUTH_BOT_TOKEN=        # Bot de plataforma para Login Widget (ej. @Colacero); fallback a TELEGRAM_BOT_TOKEN
# TELEGRAM_CHANNEL_ID=            # Canal público para anuncios (opcional)
# TELEGRAM_NOTIFY_CHAT_ID=        # Grupo interno del negocio (opcional)
# CATALOG_URL=https://el-fogon.colacero.com   # URL de la Mini App (opcional)

# ── Catalog frontend (Next.js public env) ────────────────────────────────
# Username del bot SIN @ — debe coincidir con el bot configurado en /setdomain
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=Colacero
