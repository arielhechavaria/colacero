# ══════════════════════════════════════════════════════════════
# ColaCero — Variables de entorno para PRODUCCIÓN
# Copiar como .env en el VPS y rellenar los valores reales.
# NUNCA commitear este archivo con valores reales.
# ══════════════════════════════════════════════════════════════

# ── Node ──────────────────────────────────────────────────────
NODE_ENV=production

# ── Base de datos ─────────────────────────────────────────────
POSTGRES_USER=colacero
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
POSTGRES_DB=colacero_prod
DATABASE_URL=postgresql://colacero:CAMBIAR_POR_PASSWORD_SEGURO@postgres:5432/colacero_prod

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIAR_POR_SECRET_DE_64_CHARS_MINIMO
JWT_EXPIRES_IN=7d

# ── Cookies + Refresh tokens ─────────────────────────────────
# Generar COOKIE_SECRET con: openssl rand -hex 32
COOKIE_SECRET=CAMBIAR_POR_COOKIE_SECRET_DE_64_CHARS_MINIMO
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_TTL_DAYS=30

# ── OTP ───────────────────────────────────────────────────────
OTP_TTL_SECONDS=600

# ── WhatsApp (mantener mock hasta integrar proveedor real) ────
WHATSAPP_PROVIDER=mock

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_PROVIDER=bot-api
TELEGRAM_BOT_TOKEN=CAMBIAR_POR_TOKEN_DEL_BOT
TELEGRAM_CHANNEL_ID=@tuCanalDeTelegram

# ── API ───────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
API_PUBLIC_URL=https://api.colacero.com
UPLOAD_DIR=/app/uploads

# ── Catalog / Panel ───────────────────────────────────────────
# Sin dominio: usar red interna de Docker (nombre del servicio)
CATALOG_API_URL=http://api:3000
# Con dominio: CATALOG_API_URL=https://tudominio.com
API_HOSTNAME=api.colacero.com

# ── Cuando tengas dominio ─────────────────────────────────────
# Cambiar API_PUBLIC_URL=https://tudominio.com
# Cambiar API_HOSTNAME=tudominio.com
# Activar nginx en docker-compose.prod.yml
# Obtener SSL con certbot

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGIN=https://panel.colacero.com,https://elfogon.colacero.com