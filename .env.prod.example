# ══════════════════════════════════════════════════════════════
# ColaCero — Variables de entorno para PRODUCCIÓN
# Copiar como .env en el VPS y rellenar los valores reales.
# NUNCA commitear este archivo con valores reales.
# ══════════════════════════════════════════════════════════════

# ── Node ──────────────────────────────────────────────────────
NODE_ENV=production

# ── Base de datos ─────────────────────────────────────────────
POSTGRES_USER=colacero
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
POSTGRES_DB=colacero_prod
DATABASE_URL=postgresql://colacero:CAMBIAR_POR_PASSWORD_SEGURO@postgres:5432/colacero_prod

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIAR_POR_SECRET_DE_64_CHARS_MINIMO
JWT_EXPIRES_IN=7d

# ── OTP ───────────────────────────────────────────────────────
OTP_TTL_SECONDS=600

# ── WhatsApp (mantener mock hasta integrar proveedor real) ────
WHATSAPP_PROVIDER=mock

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_PROVIDER=bot-api
TELEGRAM_BOT_TOKEN=CAMBIAR_POR_TOKEN_DEL_BOT
TELEGRAM_CHANNEL_ID=@tuCanalDeTelegram

# ── API ───────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
API_PUBLIC_URL=https://tudominio.com
UPLOAD_DIR=/app/uploads

# ── Catalog / Panel ───────────────────────────────────────────
CATALOG_API_URL=http://api:3000
API_HOSTNAME=tudominio.com

# ── Nginx / dominio ───────────────────────────────────────────
# Actualizar también en infra/nginx/nginx.conf
# DOMAIN=tudominio.com
