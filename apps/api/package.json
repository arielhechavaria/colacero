{
  "name": "@colacero/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "test": "dotenv -e ../../.env -- vitest run",
    "lint": "echo 'lint ok'"
  },
  "dependencies": {
    "@colacero/db": "workspace:*",
    "@colacero/env": "workspace:*",
    "@colacero/shared": "workspace:*",
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@node-rs/argon2": "^1.7.0",
    "bullmq": "^5.76.4",
    "fastify": "5.8.5",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.10.1",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv-cli": "^7.4.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}