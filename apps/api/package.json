{
  "name": "@colacero/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "test": "dotenv -e ../../.env -- vitest run",
    "lint": "echo 'lint ok'"
  },
  "dependencies": {
    "@colacero/db": "workspace:*",
    "@colacero/env": "workspace:*",
    "@colacero/shared": "workspace:*",
    "@fastify/jwt": "^8.0.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "@node-rs/argon2": "^1.7.0",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv-cli": "^7.4.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}