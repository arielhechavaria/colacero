{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "NODE_ENV",
        "JWT_SECRET",
        "CATALOG_API_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}