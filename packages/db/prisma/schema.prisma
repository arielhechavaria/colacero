generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Business ────────────────────────────────────────────────────────────────

model Business {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  description        String?
  timezone           String             @default("America/Havana")
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  status             BusinessStatus     @default(ACTIVE)
  onboardedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users         User[]
  products      Product[]
  pickupWindows PickupWindow[]
  orders        Order[]
  announcements Announcement[]
}

// ─── User (staff del negocio) ────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  businessId      String
  email           String
  passwordHash    String
  role            UserRole  @default(STAFF)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  business                Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@unique([email])
  @@index([businessId])
}

// ─── Customer (auth via Telegram Mini App) ───────────────────────────────────

model Customer {
  id          String    @id @default(cuid())
  telegramId  String?   @unique   // Telegram user.id — auth principal
  phone       String?   @unique   // fallback OTP (opcional)
  displayName String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  orders        Order[]
  refreshTokens RefreshToken[]
}

// ─── RefreshToken (auth: rotation + theft detection) ─────────────────────────

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String?            // owner refresh token (User)
  customerId String?            // customer refresh token (Telegram or OTP)
  tokenHash  String    @unique  // sha256 of opaque token (NEVER store raw)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?
  ipAddress  String?

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
  @@index([expiresAt])
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  businessId  String
  sku         String?
  name        String
  description String?
  unitPrice   Decimal  @db.Decimal(10, 2)
  unitLabel   String   @default("unidad")
  imageUrl    String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  orderItems OrderItem[]

  @@unique([businessId, sku])
  @@index([businessId, isActive])
}

// ─── Inventory (optimistic locking via version) ──────────────────────────────

model Inventory {
  productId          String   @id
  quantityAvailable  Int      @default(0)
  quantityReserved   Int      @default(0)
  lowStockThreshold  Int      @default(5)
  version            Int      @default(0)
  updatedAt          DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── PickupWindow ────────────────────────────────────────────────────────────

model PickupWindow {
  id          String   @id @default(cuid())
  businessId  String
  date        DateTime @db.Date
  startTime   String
  endTime     String
  capacity    Int
  ordersCount Int      @default(0)
  isOpen      Boolean  @default(true)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([businessId, date, isOpen])
}

// ─── Order ───────────────────────────────────────────────────────────────────

model Order {
  id             String      @id @default(cuid())
  businessId     String
  customerId     String
  pickupWindowId String?
  status         OrderStatus @default(DRAFT)
  subtotal       Decimal     @db.Decimal(10, 2)
  pickupCode     String?     @db.VarChar(6)
  notes          String?
  createdAt      DateTime    @default(now())
  confirmedAt    DateTime?
  readyAt        DateTime?
  pickedUpAt     DateTime?
  expiresAt      DateTime?

  business      Business      @relation(fields: [businessId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  pickupWindow  PickupWindow? @relation(fields: [pickupWindowId], references: [id])
  items         OrderItem[]
  notifications Notification[]

  @@index([businessId, status, pickupWindowId])
  @@index([customerId, createdAt(sort: Desc)])
}

// ─── OrderItem ───────────────────────────────────────────────────────────────

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  productId         String
  quantity          Int
  unitPriceSnapshot Decimal @db.Decimal(10, 2)
  subtotal          Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id           String             @id @default(cuid())
  orderId      String
  channel      String             @default("whatsapp")
  templateName String
  payload      Json
  status       NotificationStatus @default(PENDING)
  sentAt       DateTime?
  errorMessage String?
  retryCount   Int                @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── Announcement (mensajes al canal de Telegram, persistente) ────────────────

model Announcement {
  id           String              @id @default(cuid())
  businessId   String
  text         String
  template     String?             // 'daily', 'offer', 'reminder', 'custom', 'ai', etc.
  productIds   String[]            @default([])
  imageUrl     String?             // imagen adjunta por el user (uploads)
  generatedPng String?             // PNG generado server-side via Satori
  scheduledAt  DateTime?           // null = enviar inmediato
  status       AnnouncementStatus  @default(DRAFT)
  sentAt       DateTime?
  errorMessage String?
  jobId        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt(sort: Desc)])
  @@index([scheduledAt, status])
}

// ─── Lead (captura de interesados) ───────────────────────────────────────────

model Lead {
  id           String     @id @default(cuid())
  email        String
  phone        String?
  telegram     String?
  businessKind String?
  message      String?
  source       String     @default("landing")
  status       LeadStatus @default(NEW)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ─── EmailVerificationToken ───────────────────────────────────────────────────

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── PasswordResetToken ───────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
  EXPIRED
}

enum UserRole {
  OWNER
  STAFF
  SUPER_ADMIN
}

enum BusinessStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  CONVERTED
  LOST
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}
